              leftSection={<IconCalendar size={16} />}
              data={[
                { value: '1h', label: 'Last 1 hour' },
                { value: '24h', label: 'Last 24 hours' },
                { value: '7d', label: 'Last 7 days' },
                { value: '30d', label: 'Last 30 days' },
                { value: 'custom', label: 'Custom range' },
              ]}
            />

            {query.timeRange === 'custom' && (
              <Group grow>
                <DateTimePicker
                  label="Start Date"
