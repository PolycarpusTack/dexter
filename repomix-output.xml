    cors_origins: Union[List[str], str] = Field(["http://localhost:5173", "http://localhost:3000"], env="CORS_ORIGINS")
    
    # Sentry organization config (used in discover.py)
    SENTRY_ORG: str = Field("", env="SENTRY_ORG")

