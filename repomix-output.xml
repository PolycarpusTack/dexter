    expect(mockApi.calls).toEqual([
      { endpoint: '/issues', params: { cursor: null, limit: 100 } },
      { endpoint: '/issues', params: { cursor: 'next-cursor', limit: 100 } }
    ]);
  });
});
```

### 2. Integration Testing
