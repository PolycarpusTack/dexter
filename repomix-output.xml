// Export a dummy function to avoid unused file warnings
export function configureModuleResolution() {
  return {
    resolve: {
      extensions: ['.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs'],
      alias: {
        '@': '/src',
        '@api': '/src/api',
        '@components': '/src/components',
        '@utils': '/src/utils',
        '@store': '/src/store',
        '@assets': '/src/assets'
