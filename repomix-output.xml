  // Or handle based on category
  if (error.category === ErrorCategory.AUTH) {
    // Handle authentication error
  } else if (error.category === ErrorCategory.NETWORK) {
    // Handle network error
  } else if (error.category === ErrorCategory.SERVER) {
    // Handle server error
  }
}
