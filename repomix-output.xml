    expect(mockService.callCount).toBe(1);
    
    // Second call should use cache
    const result2 = await cachedFetchData('123');
    expect(mockService.callCount).toBe(1);
    expect(result1).toEqual(result2);
  });
  
  it('@deduplicated decorator should prevent duplicate calls', async () => {
    const mockService = {
      callCount: 0,
