    return makeRequest({
      method: 'GET',
      url: `/projects/${projectSlug}/${endpoint}/${ruleId}/`,
    });
  },

  async createAlertRule(projectSlug: string, type: 'issue' | 'metric', data: IssueAlertRule | MetricAlertRule): Promise<AlertRuleResponse> {
