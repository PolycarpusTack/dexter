        size="lg"
      >
        <ModelSelector onModelChange={handleModelChange} />
      </Modal>
      
      {/* Advanced Settings Modal */}
      <Modal
        opened={advancedSettingsOpen}
        onClose={() => setAdvancedSettingsOpen(false)}
