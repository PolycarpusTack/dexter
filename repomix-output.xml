```jsx
import React, { useState } from 'react';
import { useIssueDetails, useIssueEvents, useEventDetails } from '../hooks';

const IssueDetailsWithEvents = ({ organization, issueId }) => {
  const [selectedEventId, setSelectedEventId] = useState(null);
  
