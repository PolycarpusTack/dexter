  /** Display preferences */
  displayPreferences: {
    /** Show expanded stack traces */
    expandedStackTraces: boolean;
    /** Show context data */
    showContext: boolean;
    /** Show raw data */
    showRawData: boolean;
    /** Default masking of sensitive data */
    defaultMasking: boolean;
  };
