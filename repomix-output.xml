                      {explainMutation.data?.model && (
                        <Badge size="xs" color="gray" variant="outline">
                          {explainMutation.data.model}
                        </Badge>
                      )}
                    </Group>
                  </Stack>
                </Paper>
                
                <Group justify="right" mt="xs">
                  <Button 
                    size="xs" 
                    variant="subtle" 
                    color="gray"
                    leftSection={<IconRobot size={14} />}
