    return await apiClient.get<EventsResponse>(
      `/issue/${issueId}/events`,
      { params: options }
    );
  } catch (error) {
    handleEventsError(error, {
      operation: 'fetchIssueEvents',
      issueId,
      ...options
    });
    throw error;
