            raw_message=message,
            transactions={tx.process_id: tx for tx in transactions},
            locks=locks,
            cycles=cycles,
            visualization_data={},  # Will be filled later
            recommended_fix=None  # Will be filled later
        )
        
        # Generate recommended fixes
