# Dexter Backend Environment Configuration
# ----------------------------------------
# Copy this file to .env in your backend directory
# and update the values as needed

# ========== REQUIRED SETTINGS ==========

# Sentry API Configuration
# Your Sentry API token with necessary permissions
SENTRY_API_TOKEN=your_token_here

# Default Organization and Project
# Set default Sentry organization to analyze
SENTRY_ORGANIZATION_SLUG=your-org-slug
# Optional default project
SENTRY_PROJECT_SLUG=your-project-slug

# ========== SECURITY SETTINGS ==========

# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_key_here

# CORS Settings (Critical for security)
# In production, specify exact frontend domains:
CORS_ORIGINS=["http://localhost:5173", "https://dexter.your-domain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ========== APPLICATION SETTINGS ==========

# Application Mode (default, debug, minimal, enhanced, simplified)
APP_MODE=default

# Server Configuration
DEBUG=false
PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=1

# Feature Flags
ENABLE_DEADLOCK_ANALYSIS=true
ENABLE_OLLAMA=true
ENABLE_REAL_TIME=false
ENABLE_CACHING=true

# ========== OLLAMA SETTINGS ==========

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=60

# ========== LOGGING SETTINGS ==========

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=standard
LOG_FILE_PATH=logs/dexter.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true

# ========== CACHE SETTINGS ==========

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300

# ========== ADVANCED SETTINGS ==========

# Performance Settings
REQUEST_TIMEOUT=30
MAX_CONNECTIONS=100

# Error Handling Settings
RECENT_ERRORS_LIMIT=100
INCLUDE_STACK_TRACE=false