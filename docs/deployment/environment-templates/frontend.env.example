# Dexter Frontend Environment Configuration
# -----------------------------------------
# Copy this file to .env.production in your frontend directory
# and update the values as needed

# ========== API CONFIGURATION ==========

# Backend API URL (Required)
# This should point to your deployed backend API
VITE_API_BASE_URL=https://api.your-domain.com

# Specify API version (Optional)
VITE_API_VERSION=v1

# API request timeout in milliseconds (Optional)
VITE_API_TIMEOUT=30000

# ========== APPLICATION SETTINGS ==========

# Application mode (Optional)
# Possible values: development, production, staging
VITE_APP_MODE=production

# Application version (Optional)
# Used for tracking and debugging
VITE_APP_VERSION=1.0.0

# ========== FEATURE FLAGS ==========

# Enable/disable specific features (Optional)

# Analytics integration
VITE_ENABLE_ANALYTICS=true

# Error tracking with Sentry
VITE_ENABLE_SENTRY=true

# Real-time updates
VITE_ENABLE_REAL_TIME=false

# Experimental features
VITE_ENABLE_EXPERIMENTAL=false

# ========== ERROR TRACKING ==========

# Sentry DSN for frontend error tracking (Optional but recommended for production)
VITE_SENTRY_DSN=https://your-sentry-dsn

# Sentry environment (Optional)
VITE_SENTRY_ENVIRONMENT=production

# Sentry trace sample rate (Optional)
# Value between 0 and 1, e.g., 0.1 for 10% of transactions
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ========== UI CONFIGURATION ==========

# Theme settings (Optional)
VITE_DEFAULT_THEME=light

# Animation settings (Optional)
VITE_ENABLE_ANIMATIONS=true

# ========== PERFORMANCE ==========

# Cache duration in seconds (Optional)
VITE_CACHE_DURATION=3600

# Enable service worker (Optional)
VITE_ENABLE_SERVICE_WORKER=false