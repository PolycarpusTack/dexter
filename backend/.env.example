# Dexter Backend Environment Variables

# Application Mode (NEW)
APP_MODE=default               # default, debug, minimal, enhanced, simplified

# =====================================
# SECURITY CONFIGURATION (CRITICAL - MUST BE SET IN PRODUCTION)
# =====================================

# JWT Token Signing Key (CRITICAL for Issue 1 fix)
# Used for validating JWT authentication tokens in production
# MUST be changed to a strong random string (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_SECRET_AT_LEAST_32_CHARS

# CSRF Protection Key
CSRF_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# Sentry API Configuration
SENTRY_API_TOKEN=YOUR_SENTRY_API_TOKEN
SENTRY_BASE_URL=https://sentry.io/api/0/
SENTRY_WEB_URL=https://sentry.io/

# Default Organization and Project (optional but recommended)
SENTRY_ORGANIZATION_SLUG=your-org-slug
SENTRY_PROJECT_SLUG=your-project-slug

# Ollama Configuration for LLM (Primary provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=1200

# Optional Provider API Keys (install provider libraries separately if needed)
# OPENAI_API_KEY=your-openai-key  # Requires: pip install openai
# ANTHROPIC_API_KEY=your-anthropic-key  # Requires: pip install anthropic

# Application Settings
DEBUG=false
PORT=8000
HOST=0.0.0.0
RELOAD=false                   # Whether to enable auto-reload (for development)
WORKERS=1                      # Number of worker processes

# Feature Flags (NEW)
ENABLE_DEADLOCK_ANALYSIS=true  # Enable PostgreSQL deadlock analyzer
ENABLE_OLLAMA=true             # Enable AI capabilities
ENABLE_REAL_TIME=false         # Enable real-time updates
ENABLE_CACHING=true            # Enable response caching

# Logging Settings
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=standard            # standard or json
LOG_FILE_PATH=logs/dexter.log  # Path for main log file (relative to app root)
LOG_MAX_SIZE=10485760          # Max size of log files before rotation (10MB)
LOG_BACKUP_COUNT=5             # Number of backup files to keep
LOG_TO_CONSOLE=true            # Whether to output logs to console

# Cache Settings (Issue 2 fix: async Redis)
REDIS_URL=redis://localhost:6379/0  # Redis connection URL (async client with connection pooling)
CACHE_ENABLED=true             # Enable response caching
CACHE_TTL_DEFAULT=300          # Default cache TTL in seconds (5 minutes)

# Performance Settings (NEW)
REQUEST_TIMEOUT=30             # Request timeout in seconds
MAX_CONNECTIONS=100            # Maximum number of concurrent connections

# Error Handling Settings
RECENT_ERRORS_LIMIT=100        # Number of recent errors to keep in memory

# CORS Settings
CORS_ORIGINS=["http://localhost:5175", "http://localhost:5173", "http://localhost:3000", "https://dexter.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
INCLUDE_STACK_TRACE=false      # Override whether to include stack traces

# Optional: Use mock data for development (set to "true" to enable)
USE_MOCK_DATA=false

# Monitoring Settings (NEW)
SENTRY_DSN=                    # DSN for monitoring the application itself
SENTRY_ENVIRONMENT=development # Environment name for Sentry monitoring

# =====================================
# KNOWLEDGE BASE SETTINGS (Phase 1)
# =====================================

# Database Settings (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://dexter:dexter_dev@localhost:5432/dexter
DATABASE_ECHO=false            # Echo SQL statements (debug)

# Embeddings Settings (Jina v2 Code)
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_DIMENSION=768
EMBEDDING_CACHE_SIZE=1000      # LRU cache entries
EMBEDDING_DEVICE=              # cpu, cuda, or empty for auto

# PII Settings (CRITICAL - must be set for production)
PII_HASH_SALT=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_FOR_PII_HASHING
PII_SCRUB_UUIDS=true          # Scrub UUIDs (may be user IDs)

# Webhook Settings
SENTRY_CLIENT_SECRET=          # For webhook signature verification
WEBHOOK_DEDUP_WINDOW_MINUTES=5 # Deduplication window

# Knowledge Base Settings
SIMILARITY_THRESHOLD=0.7       # Minimum similarity for RAG retrieval
MAX_SIMILAR_ISSUES=5           # Max similar issues to retrieve
ENABLE_KNOWLEDGE_BASE=true     # Enable knowledge base features

# =====================================
# DATA ENRICHMENT FEATURE FLAGS
# =====================================

# Master toggle (Issue 3 fix: corrected logic)
# When ENABLE_ALL_ENRICHMENTS=true, individual flags control each enrichment source
# When ENABLE_ALL_ENRICHMENTS=false, ALL enrichment sources are disabled regardless of individual flags
# This acts as a master kill switch for all enrichments
ENABLE_ALL_ENRICHMENTS=true

# Individual enrichment sources
# Each source can be toggled independently without restart via /api/v1/config/reload-config

# Release Intelligence - Enriches issues with release and suspect commit data
ENABLE_RELEASES=true

# Performance Observability - Adds performance span and transaction data
ENABLE_PERFORMANCE_SPANS=true

# Profiling - Includes profiling data (function hotspots)
# RESOURCE INTENSIVE: Disabled by default, enable only if needed
ENABLE_PROFILING=false

# User Context - Adds session counts and replay metadata
ENABLE_SESSIONS_REPLAYS=true

# Breadcrumbs - Enriches with breadcrumb timeline data
ENABLE_BREADCRUMBS=true

# Alerts & Incidents - Correlates issues with alerts and incidents
ENABLE_ALERTS=true

# Attachments - Downloads and summarizes issue attachments
# SECURITY SENSITIVE: Disabled by default, may contain sensitive data
ENABLE_ATTACHMENTS=false

# Tag Analysis - Provides tag distributions and environment clustering
ENABLE_TAG_DISTRIBUTIONS=true

# Ownership - Includes issue ownership and team routing information
ENABLE_OWNERSHIP=true

# Measurements - Adds custom measurements and web vitals
ENABLE_MEASUREMENTS=true

# Grouping Insights - Provides grouping variants and fingerprint analysis
ENABLE_GROUPING_INSIGHTS=true

# Enrichment job settings (for future background enrichment jobs)
ENRICHMENT_BATCH_SIZE=50           # How many issues to enrich per batch
ENRICHMENT_INTERVAL_SECONDS=300    # How often to run enrichment (5 min)
ENRICHMENT_MAX_RETRIES=3           # Max retries for failed enrichment

# =====================================
# SENTRY DATA CLIENT FRAMEWORK SETTINGS
# =====================================

# Rate Limiting
SENTRY_RATE_LIMIT_REQUESTS_PER_MIN=100  # Max requests per minute to Sentry API
SENTRY_RATE_LIMIT_MAX_BURST=100         # Maximum burst size (defaults to requests_per_min)

# Circuit Breaker
SENTRY_CIRCUIT_BREAKER_THRESHOLD=5      # Failures before opening circuit
SENTRY_CIRCUIT_BREAKER_TIMEOUT=60       # Seconds before attempting recovery
SENTRY_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2  # Successes to close circuit

# Retry Logic
SENTRY_MAX_RETRIES=3                    # Maximum retry attempts
SENTRY_RETRY_BACKOFF_BASE=1             # Base delay in seconds (exponential: 1s, 2s, 4s)

# Response Caching
SENTRY_CACHE_ENABLED=true               # Enable response caching
SENTRY_CACHE_TTL=300                    # Cache TTL in seconds (5 minutes)

# Request Timeout
SENTRY_REQUEST_TIMEOUT=30               # Request timeout in seconds
